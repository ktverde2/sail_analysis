# Copy to .env for local runs. Never commit the real .env.
APP_ENV=dev                      # dev | prod
SECRET_KEY=change-me             # prod: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
ALLOWED_EMAILS=you@example.com   # comma-separated Google accounts allowed to sign in

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only: with APP_ENV=dev, skip Google and sign in as this email
DEV_USER_EMAIL=you@example.com
